{
  "name": "dsh-beme",
  "version": "0.1.5",
  "description": "给 AI 一个长期记忆库：流式汲取块省上下文、精确查找、全量可追溯。",
  "license": "MIT",
  "type": "module",
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./plugin": "./plugin/index.mjs",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "ai-memory",
    "block-memory"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shua-781/dsh-beme.git"
  },
  "author": "shua-781",
  "publishConfig": {
    "access": "public"
  }
}
